---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-brand-black">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(201,168,76,0.06)_0%,_transparent_70%)]"></div>

    <div class="relative z-10 mx-auto max-w-2xl px-6 text-center">
      <div class="animate-zoom-in mb-8 flex justify-center animate-duration-700">
        <img
          src="/logo.jpeg"
          alt="Ola & Sabor"
          class="h-36 w-36 rounded-full object-cover ring-4 ring-brand-gold/30 shadow-2xl shadow-brand-gold/10 md:h-44 md:w-44"
        />
      </div>

      <h1 class="animate-fade-in-down font-display animate-delay-200 text-5xl font-bold leading-tight text-white md:text-7xl">
        Ola & Sabor
      </h1>
      <p class="animate-fade-in-up font-display animate-delay-400 mt-3 text-xl italic text-brand-gold-400 md:text-2xl">
        Cocktail Bar
      </p>

      <div class="animate-expand-horizontally mx-auto animate-delay-500 mt-6 h-px w-20 bg-brand-gold/50"></div>

      <div class="animate-fade-in-up animate-delay-700 mt-12">
        <a
          href="/carta"
          class="inline-block rounded-full border-2 border-brand-gold px-10 py-4 font-display text-lg font-semibold text-brand-gold transition-all duration-300 hover:bg-brand-gold hover:text-brand-black hover:shadow-lg hover:shadow-brand-gold/25"
        >
          VER CARTA
        </a>
      </div>

      <div class="animate-fade-in animate-delay-900 mt-10 flex justify-center gap-8 text-xs text-brand-black-400">
        <span>Café</span>
        <span class="text-brand-gold/40">✦</span>
        <span>Coctelería</span>
        <span class="text-brand-gold/40">✦</span>
        <span>Platos</span>
      </div>
    </div>
  </section>

  <footer class="border-t border-brand-gold/20 bg-brand-black py-10">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-6 text-center">
      <p class="flex items-center gap-3 text-brand-black-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand-gold">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span class="font-desc text-sm">
          Travesía de Vigo 10, 36206 Vigo (Pontevedra)
        </span>
      </p>
      <div class="h-px w-16 bg-brand-gold/30"></div>
      <a
        href="https://www.instagram.com/olaysabor_brunch_coctel_bar?igsh=Z2tjam11dTM1bzQ2&utm_source=qr"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de Ola & Sabor"
        class="flex items-center gap-2 text-xs text-brand-black-400 transition-colors hover:text-brand-gold"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
        @olaysabor_brunch_coctel_bar
      </a>
    </div>
  </footer>
</BaseLayout>
