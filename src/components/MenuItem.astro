---
export interface Props {
  item: {
    data: {
      title: string;
      number: number;
      price: string;
      description: string;
      image?: string;
      alcohol?: boolean;
    };
  };
}

const { item } = Astro.props;
---

<div class="menu-item view-animate-[--item-reveal] animate-fade-in-up animate-range-[entry_10%_cover_30%] flex items-start gap-3 sm:gap-4">
  <!-- Image or Number -->
  <div class="shrink-0">
    {
      item.data.image ? (
        <div class="relative h-16 w-16 overflow-hidden rounded-xl ring-1 ring-brand-gold/20 sm:h-[72px] sm:w-[72px]">
          <img
            src={item.data.image}
            alt={item.data.title}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      ) : (
        <span class="mt-1 flex h-7 w-7 items-center justify-center rounded-full border border-brand-gold/40 bg-brand-gold/5 text-xs font-bold text-brand-gold">
          {String(item.data.number).padStart(2, "0")}
        </span>
      )
    }
  </div>

  <!-- Content -->
  <div class="flex-1 min-w-0 pt-0.5">
    <div class="flex items-baseline gap-2">
      <span class="flex items-center gap-2 font-name text-sm font-semibold text-white truncate sm:text-base">
        {item.data.title}
        {item.data.alcohol === false && (
          <span class="shrink-0 rounded-full border border-brand-green-400/40 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-brand-green-300">
            Sin alcohol
          </span>
        )}
      </span>
      <span class="flex-1 border-b border-dashed border-brand-gold/20 min-w-[0.5rem]"></span>
      <span class="shrink-0 font-name text-sm font-bold text-brand-gold sm:text-base">
        {item.data.price}
      </span>
    </div>
    <p class="mt-0.5 font-desc text-xs leading-relaxed text-brand-black-300">
      {item.data.description}
    </p>
  </div>
</div>
