---
import { halloween } from "../lib/season";

export interface Props {
  variant?: "hero" | "card";
}

const { variant = "hero" } = Astro.props;
const isHero = variant === "hero";
---

{
  halloween && (
    <div
      class:list={[
        "pointer-events-none absolute inset-0 z-0 overflow-hidden",
        isHero ? "" : "rounded-2xl",
      ]}
      aria-hidden="true"
    >
      {/* Telarañas en las esquinas */}
      <svg
        class="hh-web absolute left-0 top-0 h-20 w-20 sm:h-28 sm:w-28"
        viewBox="0 0 100 100"
        fill="none"
        stroke="currentColor"
        stroke-width="0.9"
        stroke-linecap="round"
      >
        <path d="M0 0 L100 6 M0 0 L95 38 M0 0 L70 70 M0 0 L38 95 M0 0 L6 100" />
        <path d="M18 0 A18 18 0 0 1 0 18" />
        <path d="M36 0 A36 36 0 0 1 0 36" />
        <path d="M54 0 A54 54 0 0 1 0 54" />
        <path d="M72 0 A72 72 0 0 1 0 72" />
        <path d="M90 0 A90 90 0 0 1 0 90" />
      </svg>

      <svg
        class="hh-web absolute right-0 top-0 h-20 w-20 sm:h-28 sm:w-28"
        style="transform: scaleX(-1)"
        viewBox="0 0 100 100"
        fill="none"
        stroke="currentColor"
        stroke-width="0.9"
        stroke-linecap="round"
      >
        <path d="M0 0 L100 6 M0 0 L95 38 M0 0 L70 70 M0 0 L38 95 M0 0 L6 100" />
        <path d="M18 0 A18 18 0 0 1 0 18" />
        <path d="M36 0 A36 36 0 0 1 0 36" />
        <path d="M54 0 A54 54 0 0 1 0 54" />
        <path d="M72 0 A72 72 0 0 1 0 72" />
        <path d="M90 0 A90 90 0 0 1 0 90" />
      </svg>

      {isHero && (
        <>
          <svg
            class="hh-web absolute bottom-0 left-0 h-20 w-20 sm:h-28 sm:w-28"
            style="transform: scaleY(-1)"
            viewBox="0 0 100 100"
            fill="none"
            stroke="currentColor"
            stroke-width="0.9"
            stroke-linecap="round"
          >
            <path d="M0 0 L100 6 M0 0 L95 38 M0 0 L70 70 M0 0 L38 95 M0 0 L6 100" />
            <path d="M18 0 A18 18 0 0 1 0 18" />
            <path d="M36 0 A36 36 0 0 1 0 36" />
            <path d="M54 0 A54 54 0 0 1 0 54" />
            <path d="M72 0 A72 72 0 0 1 0 72" />
            <path d="M90 0 A90 90 0 0 1 0 90" />
          </svg>

          <svg
            class="hh-web absolute bottom-0 right-0 h-20 w-20 sm:h-28 sm:w-28"
            style="transform: scale(-1, -1)"
            viewBox="0 0 100 100"
            fill="none"
            stroke="currentColor"
            stroke-width="0.9"
            stroke-linecap="round"
          >
            <path d="M0 0 L100 6 M0 0 L95 38 M0 0 L70 70 M0 0 L38 95 M0 0 L6 100" />
            <path d="M18 0 A18 18 0 0 1 0 18" />
            <path d="M36 0 A36 36 0 0 1 0 36" />
            <path d="M54 0 A54 54 0 0 1 0 54" />
            <path d="M72 0 A72 72 0 0 1 0 72" />
            <path d="M90 0 A90 90 0 0 1 0 90" />
          </svg>
        </>
      )}

      {/* Niebla baja */}
      <div class="hh-fog absolute inset-x-[-12%] bottom-0 h-2/3 bg-[radial-gradient(ellipse_at_bottom,_rgba(232,121,43,0.16),_transparent_68%)]" />
      <div class="hh-fog absolute inset-x-[-8%] bottom-0 h-1/2 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(91,42,110,0.28),_transparent_70%)]" />

      {isHero && (
        <>
          {/* Murciélagos */}
          <svg
            class="hh-bat"
            style="--hh-top: 16%; --hh-size: 30px; --hh-duration: 26s; --hh-delay: -3s;"
            viewBox="0 0 24 20"
            fill="currentColor"
          >
            <path d="M12 5.2c1.1 0 2.1.7 2.5 1.9C16.2 5.5 19 4.6 21.5 5c-1.3 1.3-1.9 2.8-2 4.4 1.2.4 2.1 1.3 2.5 2.5-1.6 1.5-3.6 2.1-5.5 1.7L12 18.5l-4.5-4.9c-1.9.4-3.9-.2-5.5-1.7.4-1.2 1.3-2.1 2.5-2.5-.1-1.6-.7-3.1-2-4.4 2.5-.4 5.3.5 7 2.1.4-1.2 1.4-1.9 2.5-1.9Z" />
          </svg>
          <svg
            class="hh-bat"
            style="--hh-top: 30%; --hh-size: 20px; --hh-duration: 34s; --hh-delay: -14s;"
            viewBox="0 0 24 20"
            fill="currentColor"
          >
            <path d="M12 5.2c1.1 0 2.1.7 2.5 1.9C16.2 5.5 19 4.6 21.5 5c-1.3 1.3-1.9 2.8-2 4.4 1.2.4 2.1 1.3 2.5 2.5-1.6 1.5-3.6 2.1-5.5 1.7L12 18.5l-4.5-4.9c-1.9.4-3.9-.2-5.5-1.7.4-1.2 1.3-2.1 2.5-2.5-.1-1.6-.7-3.1-2-4.4 2.5-.4 5.3.5 7 2.1.4-1.2 1.4-1.9 2.5-1.9Z" />
          </svg>
          <svg
            class="hh-bat"
            style="--hh-top: 68%; --hh-size: 16px; --hh-duration: 30s; --hh-delay: -22s;"
            viewBox="0 0 24 20"
            fill="currentColor"
          >
            <path d="M12 5.2c1.1 0 2.1.7 2.5 1.9C16.2 5.5 19 4.6 21.5 5c-1.3 1.3-1.9 2.8-2 4.4 1.2.4 2.1 1.3 2.5 2.5-1.6 1.5-3.6 2.1-5.5 1.7L12 18.5l-4.5-4.9c-1.9.4-3.9-.2-5.5-1.7.4-1.2 1.3-2.1 2.5-2.5-.1-1.6-.7-3.1-2-4.4 2.5-.4 5.3.5 7 2.1.4-1.2 1.4-1.9 2.5-1.9Z" />
          </svg>

          {/* Calabazas flotantes */}
          <div class="hh-float absolute bottom-10 left-4 opacity-30 sm:left-10 sm:opacity-40">
            <svg viewBox="0 0 64 62" width="42" height="42" fill="none" aria-hidden="true">
              <path
                d="M32 13c-3.6-4-8.6-5.2-13.5-4.2 1.9 1.9 2.9 4 2.9 6.2-4.3 2.1-7.1 6.3-7.1 11.1 0 9.4 8.2 17.1 17.7 17.1s17.7-7.7 17.7-17.1c0-4.8-2.8-9-7.1-11.1 0-2.2 1-4.3 2.9-6.2C39.6 7.8 35.6 9 32 13Z"
                fill="#E8792B"
                stroke="#8A3D12"
                stroke-width="1.6"
              />
              <path d="M32 13v30" stroke="#8A3D12" stroke-width="1.6" />
              <path d="M21 18c1.2 7.2 2.2 15.5 3.6 24M43 18c-1.2 7.2-2.2 15.5-3.6 24" stroke="#8A3D12" stroke-width="1.2" opacity=".65" />
              <path d="M31.5 13c-.2-3 .8-5.2 3.4-6.6" stroke="#4A7C3F" stroke-width="2.6" stroke-linecap="round" />
            </svg>
          </div>
          <div class="hh-float absolute right-6 top-1/3 opacity-20 [animation-delay:-2.5s] sm:right-16 sm:opacity-30">
            <svg viewBox="0 0 64 62" width="34" height="34" fill="none" aria-hidden="true">
              <path
                d="M32 13c-3.6-4-8.6-5.2-13.5-4.2 1.9 1.9 2.9 4 2.9 6.2-4.3 2.1-7.1 6.3-7.1 11.1 0 9.4 8.2 17.1 17.7 17.1s17.7-7.7 17.7-17.1c0-4.8-2.8-9-7.1-11.1 0-2.2 1-4.3 2.9-6.2C39.6 7.8 35.6 9 32 13Z"
                fill="#E8792B"
                stroke="#8A3D12"
                stroke-width="1.6"
              />
              <path d="M32 13v30" stroke="#8A3D12" stroke-width="1.6" />
              <path d="M31.5 13c-.2-3 .8-5.2 3.4-6.6" stroke="#4A7C3F" stroke-width="2.6" stroke-linecap="round" />
            </svg>
          </div>
        </>
      )}

      {/* Araña colgando (solo en la carta) */}
      {!isHero && (
        <div class="hh-spider absolute -top-1 right-8 text-brand-gold/50">
          <svg viewBox="0 0 24 34" width="22" height="30" fill="none" aria-hidden="true">
            <path d="M12 0v13" stroke="currentColor" stroke-width="1" />
            <g stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
              <path d="M9.6 15.5 6.5 13 4 13.5M9.6 17.5 6 18l-2 1.5M9.6 19.5 6.5 22l-1.5 2" />
              <path d="M14.4 15.5 17.5 13 20 13.5M14.4 17.5 18 18l2 1.5M14.4 19.5 17.5 22l1.5 2" />
            </g>
            <ellipse cx="12" cy="17.8" rx="2.6" ry="3.4" fill="currentColor" />
            <circle cx="12" cy="14.3" r="1.5" fill="currentColor" />
          </svg>
        </div>
      )}
    </div>
  )
}
